{
  "version": 1,
  "docsGlobs": [
    "apps/docs/api/**/*.mdx",
    "apps/docs/configuration/**/*.mdx",
    "apps/docs/api-reference/**/*.mdx"
  ],
  "ignorePaths": [],
  "codeMappings": [
    {
      "source": "apps/api/app/health/**",
      "target": "apps/docs/api/health.mdx"
    },
    {
      "source": "apps/docs/api-reference/openapi.json",
      "target": "apps/docs/api-reference/endpoint/"
    }
  ],
  "rules": [
    "When an endpoint adds or changes a response header, its page in apps/docs/api/ must list the header under a \"Headers\" heading."
  ]
}
